# 替换成飞牛文件管理中对应目录的宿主机绝对路径，先创建目录。
NAS_MEDIA_DIR=/vol1/1000/视频
NAS_DATA_DIR=/vol1/1000/docker/video-nas-tools-data

# 填写对以上目录有权限的 NAS 用户 UID 和 GID，可通过 id 查看。
NAS_UID=1000
NAS_GID=1000

# 从局域网访问时改成 NAS 的局域网 IP，例如 192.168.1.20。
NAS_BIND_IP=127.0.0.1
NAS_PORT=8899

# 首次部署可只读浏览、预览和查重。需要修改或输出文件时改为 false。
NAS_MEDIA_READ_ONLY=true

# 从源码构建时使用的本地镜像标签。
VIDEO_NAS_IMAGE=video-nas-tools:local
